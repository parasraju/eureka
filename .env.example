# AI Creative Benchmark Finder - Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: for OpenAI-compatible endpoints

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
GOOGLE_API_KEY=...      

# OpenRouter (optional - for many models via one key)
OPENROUTER_API_KEY=...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Semantic Scholar (optional - for paper discovery)
SEMANTIC_SCHOLAR_API_KEY=...

# GitHub (optional - for repo discovery)
GITHUB_TOKEN=...

# Hugging Face (optional - for dataset discovery)
HF_TOKEN=...

# Budget control
CBF_MAX_USD=50.0  # Maximum spend per run

# Logging
CBF_LOG_LEVEL=INFO